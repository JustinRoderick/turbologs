# Local Convex CLI / dev tooling only.
CONVEX_DEPLOYMENT=""

# TanStack Start / Vite public env.
VITE_CONVEX_URL=""
VITE_CONVEX_SITE_URL=""
VITE_PUBLIC_POSTHOG_KEY=""
VITE_PUBLIC_POSTHOG_HOST=""

# Convex runtime env.
# Set these in Convex deployment settings or via `npx convex env set`.
BETTER_AUTH_SECRET=""
SITE_URL=""

VITE_SITE_URL=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Drag-run weather enrichment (optional; free Open-Meteo works without a key for non-commercial).
# For commercial production use a paid Open-Meteo key.
OPEN_METEO_API_KEY=""

# Time-slip OCR (optional). Without this key, slips can still be uploaded and entered manually.
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_VISION_MODEL="gpt-4o-mini"
